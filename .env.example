# Copy to .env and fill in. Never commit .env. pickspin reads these from the environment,
# so export them before running a command (bash: set -a; . ./.env; set +a).

# OpenAI-compatible endpoint for the LLM judge (pickspin baseline judge)
JUDGE_API_BASE=https://your-llm-endpoint.example.org/v1
JUDGE_API_KEY=your_api_key_here
JUDGE_MODEL=gpt-oss

# Optional bearer token for the vLLM servers (pickspin live, pickspin baseline run)
VLLM_API_KEY=

# Optional path to an endpoint map for pickspin live and pickspin baseline run
# (default: deploy/endpoints.example.json; --endpoints overrides it)
PS_ENDPOINTS=

# Hugging Face token for gated weights (used by the Helm chart via a Secret)
HF_TOKEN=
