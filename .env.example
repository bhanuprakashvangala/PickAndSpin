# Copy to .env and fill in. Never commit .env.

# OpenAI-compatible endpoint for the LLM judge (src/baseline/llm_judge.py)
JUDGE_API_BASE=https://your-llm-endpoint.example.org/v1
JUDGE_API_KEY=your_api_key_here
JUDGE_MODEL=gpt-oss

# Optional bearer token for the vLLM servers
VLLM_API_KEY=

# Optional path to an endpoint map (default: deploy/endpoints.example.json)
PS_ENDPOINTS=

# Hugging Face token for gated weights (used by the Helm chart via a Secret)
HF_TOKEN=
