{
 "apiVersion": "v1",
 "kind": "List",
 "items": [
  {
   "apiVersion": "batch/v1",
   "kind": "Job",
   "metadata": {
    "name": "bhanu-pickspin-llama32-1b",
    "labels": {
     "app": "pickspin-server",
     "model": "bhanu-pickspin-llama32-1b"
    }
   },
   "spec": {
    "backoffLimit": 0,
    "activeDeadlineSeconds": 21600,
    "template": {
     "metadata": {
      "labels": {
       "app": "pickspin-server",
       "model": "bhanu-pickspin-llama32-1b"
      }
     },
     "spec": {
      "restartPolicy": "Never",
      "affinity": {
       "nodeAffinity": {
        "requiredDuringSchedulingIgnoredDuringExecution": {
         "nodeSelectorTerms": [
          {
           "matchExpressions": [
            {
             "key": "nvidia.com/gpu.product",
             "operator": "In",
             "values": [
              "NVIDIA-A10",
              "NVIDIA-GeForce-RTX-3090",
              "NVIDIA-GeForce-RTX-4090",
              "NVIDIA-L4",
              "NVIDIA-RTX-A6000",
              "NVIDIA-L40",
              "NVIDIA-L40S"
             ]
            }
           ]
          }
         ]
        }
       }
      },
      "containers": [
       {
        "name": "vllm",
        "image": "vllm/vllm-openai:v0.8.5",
        "args": [
         "--model=meta-llama/Llama-3.2-1B-Instruct",
         "--port=8000",
         "--max-model-len=4096",
         "--gpu-memory-utilization=0.9",
         "--tensor-parallel-size=1"
        ],
        "env": [
         {
          "name": "HF_HOME",
          "value": "/cache"
         },
         {
          "name": "HF_HUB_OFFLINE",
          "value": "1"
         },
         {
          "name": "HF_TOKEN",
          "valueFrom": {
           "secretKeyRef": {
            "name": "bhanu-pickspin-hf",
            "key": "HF_TOKEN",
            "optional": true
           }
          }
         }
        ],
        "ports": [
         {
          "containerPort": 8000
         }
        ],
        "readinessProbe": {
         "httpGet": {
          "path": "/health",
          "port": 8000
         },
         "periodSeconds": 5,
         "failureThreshold": 600
        },
        "resources": {
         "requests": {
          "cpu": "4",
          "memory": "12Gi",
          "nvidia.com/gpu": 1
         },
         "limits": {
          "cpu": "4",
          "memory": "12Gi",
          "nvidia.com/gpu": 1
         }
        },
        "volumeMounts": [
         {
          "name": "hf-cache",
          "mountPath": "/cache"
         },
         {
          "name": "shm",
          "mountPath": "/dev/shm"
         }
        ]
       }
      ],
      "volumes": [
       {
        "name": "hf-cache",
        "persistentVolumeClaim": {
         "claimName": "bhanu-pickspin-hf-cache"
        }
       },
       {
        "name": "shm",
        "emptyDir": {
         "medium": "Memory",
         "sizeLimit": "8Gi"
        }
       }
      ]
     }
    }
   }
  },
